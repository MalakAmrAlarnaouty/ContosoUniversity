@model ContosoUniversity.ViewModels.InstructorFormViewModel

@{
    ViewData["Title"] = "Edit Instructor";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="mb-1">Edit Instructor</h2>

        <p class="text-muted mb-0">
            Update the instructor information and course assignments.
        </p>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Instructors
    </a>

</div>

<div class="row justify-content-center">

    <div class="col-lg-9">

        <form asp-action="Edit"
              asp-route-id="@Model.InstructorID"
              method="post">

            <input asp-for="InstructorID"
                   type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <div class="card shadow-sm mb-4">

                <div class="card-header">
                    <strong>Instructor Information</strong>
                </div>

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="FirstMidName"
                                   class="form-label">
                            </label>

                            <input asp-for="FirstMidName"
                                   class="form-control" />

                            <span asp-validation-for="FirstMidName"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="LastName"
                                   class="form-label">
                            </label>

                            <input asp-for="LastName"
                                   class="form-control" />

                            <span asp-validation-for="LastName"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="HireDate"
                                   class="form-label">
                            </label>

                            <input asp-for="HireDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="HireDate"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="OfficeLocation"
                                   class="form-label">
                            </label>

                            <input asp-for="OfficeLocation"
                                   class="form-control" />

                            <span asp-validation-for="OfficeLocation"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-12 mb-3">

                            <label asp-for="DepartmentID"
                                   class="form-label">
                            </label>

                            <select asp-for="DepartmentID"
                                    class="form-select">

                                <option value="">
                                    Select a department
                                </option>

                                @foreach (var department in Model.Departments)
                                {
                                    <option value="@department.DepartmentID"
                                            selected="@(Model.DepartmentID == department.DepartmentID
                                                                                        ? "selected"
                                                                                        : null)">
                                        @department.Name
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="DepartmentID"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>

            </div>

            <div class="card shadow-sm mb-4">

                <div class="card-header">
                    <strong>Assigned Courses</strong>
                </div>

                <div class="card-body">

                    <select asp-for="SelectedCourseIds"
                            class="form-select"
                            multiple
                            size="8">

                        @foreach (var course in Model.Courses)
                        {
                            <option value="@course.CourseID"
                                    selected="@(Model.SelectedCourseIds.Contains(course.CourseID)
                                                                        ? "selected"
                                                                        : null)">
                                @course.CourseID -
                                @course.Title
                                (@course.Credits credits)
                            </option>
                        }

                    </select>

                    <div class="form-text">
                        Hold Ctrl to select or remove multiple courses.
                    </div>

                </div>

            </div>

            <div class="d-flex gap-2 mb-4">

                <button type="submit"
                        class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
