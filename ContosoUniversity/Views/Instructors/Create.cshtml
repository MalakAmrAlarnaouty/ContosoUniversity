@model ContosoUniversity.ViewModels.InstructorFormViewModel

@{
    ViewData["Title"] = "Create Instructor";
}

<div class="d-flex flex-column
    flex-md-row
    justify-content-between
    align-items-md-center
    gap-3
    mb-4">

    <div>
        <h2 class="mb-1">
            Create Instructor
        </h2>

        <p class="text-muted mb-0">
            Enter the instructor information and assign courses
            from their department.
        </p>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Instructors
    </a>

</div>

<form asp-action="Create"
      method="post">

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <strong>Instructor Information</strong>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label asp-for="FirstMidName"
                           class="form-label">
                    </label>

                    <input asp-for="FirstMidName"
                           class="form-control"
                           placeholder="Enter first name" />

                    <span asp-validation-for="FirstMidName"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="LastName"
                           class="form-label">
                    </label>

                    <input asp-for="LastName"
                           class="form-control"
                           placeholder="Enter last name" />

                    <span asp-validation-for="LastName"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="HireDate"
                           class="form-label">
                    </label>

                    <input asp-for="HireDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="HireDate"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="OfficeLocation"
                           class="form-label">
                    </label>

                    <input asp-for="OfficeLocation"
                           class="form-control"
                           placeholder="Enter office location" />

                    <span asp-validation-for="OfficeLocation"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="DepartmentID"
                           class="form-label">
                    </label>

                    <select id="DepartmentID"
                            name="DepartmentID"
                            class="form-select">

                        <option value="">
                            Select a department
                        </option>

                        @foreach (var department in Model.Departments)
                        {
                            if (Model.DepartmentID ==
                                department.DepartmentID)
                            {
                                <option value="@department.DepartmentID"
                                        selected>
                                    @department.Name
                                </option>
                            }
                            else
                            {
                                <option value="@department.DepartmentID">
                                    @department.Name
                                </option>
                            }
                        }

                    </select>

                    <span asp-validation-for="DepartmentID"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>

    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <strong>Assigned Courses</strong>
        </div>

        <div class="card-body">

            <p class="text-muted">
                Only courses belonging to the selected department
                are available.
            </p>

            <div id="selectDepartmentMessage"
                 class="alert alert-info">

                Select a department to view its courses.

            </div>

            <div id="noCoursesMessage"
                 class="alert alert-warning d-none">

                No courses are assigned to this department.

            </div>

            <div id="courseContainer"
                 class="row g-3">

                @foreach (var course in Model.Courses)
                {
                    bool selected =
                        Model.SelectedCourseIds.Contains(
                            course.CourseID);

                    string checkboxId =
                        $"course-{course.CourseID}";

                    <div class="col-md-6
                        col-xl-4
                        instructor-course-option"
                         data-department-id="@(course.DepartmentID?.ToString()
                                                    ?? string.Empty)">

                        <input type="checkbox"
                               id="@checkboxId"
                               name="SelectedCourseIds"
                               value="@course.CourseID"
                               class="course-checkbox visually-hidden"
                               checked="@(selected
                                                           ? "checked"
                                                           : null)" />

                        <label for="@checkboxId"
                               class="card
                            course-selection-card
                            h-100">

                            <div class="card-body">

                                <div class="d-flex
                                    justify-content-between
                                    align-items-start
                                    gap-2">

                                    <div>

                                        <h5 class="mb-1">
                                            @course.Title
                                        </h5>

                                        <small class="text-muted">
                                            Course ID:
                                            @course.CourseID
                                        </small>

                                    </div>

                                    <span class="badge
                                        bg-primary
                                        selected-badge">

                                        Selected
                                    </span>

                                </div>

                                <hr />

                                <div class="d-flex
                                    justify-content-between">

                                    <span>
                                        @course.Credits credits
                                    </span>

                                    <span class="text-muted">
                                        @(course.Department?.Name
                                            ?? "No department")
                                    </span>

                                </div>

                            </div>

                        </label>

                    </div>
                }

            </div>

            <span asp-validation-for="SelectedCourseIds"
                  class="text-danger">
            </span>

        </div>

    </div>

    <div class="d-flex gap-2 mb-4">

        <button type="submit"
                class="btn btn-primary">
            Create Instructor
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </div>

</form>

<style>
    .course-selection-card {
        cursor: pointer;
        border: 2px solid transparent;
        transition:
            border-color 0.15s ease,
            background-color 0.15s ease,
            transform 0.15s ease;
    }

    .course-selection-card:hover {
        border-color: var(--bs-primary);
        transform: translateY(-2px);
    }

    .selected-badge {
        visibility: hidden;
    }

    .course-checkbox:checked
    + .course-selection-card {
        border-color: var(--bs-primary);
        background-color:
            rgba(var(--bs-primary-rgb), 0.08);
    }

    .course-checkbox:checked
    + .course-selection-card
    .selected-badge {
        visibility: visible;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const departmentSelect =
                    document.getElementById(
                        "DepartmentID"
                    );

                const courseOptions =
                    document.querySelectorAll(
                        ".instructor-course-option"
                    );

                const selectDepartmentMessage =
                    document.getElementById(
                        "selectDepartmentMessage"
                    );

                const noCoursesMessage =
                    document.getElementById(
                        "noCoursesMessage"
                    );

                function filterCourses(
                    clearHiddenSelections) {

                    const departmentId =
                        departmentSelect.value;

                    let visibleCount = 0;

                    courseOptions.forEach(
                        function (option) {

                            const belongs =
                                departmentId !== "" &&
                                option.dataset.departmentId ===
                                departmentId;

                            option.classList.toggle(
                                "d-none",
                                !belongs
                            );

                            const checkbox =
                                option.querySelector(
                                    ".course-checkbox"
                                );

                            checkbox.disabled = !belongs;

                            if (
                                !belongs &&
                                clearHiddenSelections
                            ) {
                                checkbox.checked = false;
                            }

                            if (belongs) {
                                visibleCount++;
                            }
                        }
                    );

                    selectDepartmentMessage
                        .classList.toggle(
                            "d-none",
                            departmentId !== ""
                        );

                    noCoursesMessage
                        .classList.toggle(
                            "d-none",
                            departmentId === "" ||
                            visibleCount > 0
                        );
                }

                departmentSelect.addEventListener(
                    "change",
                    function () {

                        filterCourses(true);
                    }
                );

                filterCourses(false);
            }
        );
    </script>
}