@model ContosoUniversity.Models.Course

@{
    ViewData["Title"] = "Create Course";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Create Course</h2>

        <p class="text-muted mb-0">
            Enter the information for the new course.
        </p>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Courses
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9">

        <form asp-action="Create"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <!-- Course information card -->
            <div class="card shadow-sm mb-4">

                <div class="card-header">
                    <strong>Course Information</strong>
                </div>

                <div class="card-body">
                    <div class="row">

                        <div class="col-md-6 mb-4">
                            <label asp-for="CourseID"
                                   class="form-label">
                            </label>

                            <input asp-for="CourseID"
                                   type="number"
                                   min="1"
                                   max="99999"
                                   class="form-control"
                                   placeholder="Example: 1050" />

                            <span asp-validation-for="CourseID"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                The course ID must be unique.
                            </div>
                        </div>

                        <div class="col-md-6 mb-4">
                            <label asp-for="Credits"
                                   class="form-label">
                            </label>

                            <input asp-for="Credits"
                                   type="number"
                                   min="1"
                                   max="10"
                                   class="form-control" />

                            <span asp-validation-for="Credits"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Credits must be between 1 and 10.
                            </div>
                        </div>

                        <div class="col-12 mb-3">
                            <label asp-for="Title"
                                   class="form-label">
                            </label>

                            <input asp-for="Title"
                                   class="form-control"
                                   placeholder="Example: Introduction to Programming" />

                            <span asp-validation-for="Title"
                                  class="text-danger">
                            </span>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Live preview card -->
            <div class="card shadow-sm mb-4">

                <div class="card-header">
                    <strong>Course Preview</strong>
                </div>

                <div class="card-body">
                    <div class="card border-primary">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start mb-3">

                                <div>
                                    <h4 id="courseTitlePreview"
                                        class="card-title mb-1">
                                        New Course
                                    </h4>

                                    <span class="text-muted">
                                        Course ID:
                                        <span id="courseIdPreview">
                                            Not entered
                                        </span>
                                    </span>
                                </div>

                                <span class="badge bg-primary">
                                    New
                                </span>
                            </div>

                            <hr />

                            <div class="row text-center">

                                <div class="col-6">
                                    <small class="text-muted d-block">
                                        Credits
                                    </small>

                                    <strong id="courseCreditsPreview">
                                        3
                                    </strong>
                                </div>

                                <div class="col-6">
                                    <small class="text-muted d-block">
                                        Enrolled Students
                                    </small>

                                    <strong>
                                        0
                                    </strong>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mb-4">

                <button type="submit"
                        class="btn btn-primary">
                    Create Course
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const courseIdInput =
                document.getElementById("CourseID");

            const titleInput =
                document.getElementById("Title");

            const creditsInput =
                document.getElementById("Credits");

            const courseIdPreview =
                document.getElementById("courseIdPreview");

            const titlePreview =
                document.getElementById("courseTitlePreview");

            const creditsPreview =
                document.getElementById("courseCreditsPreview");

            function updatePreview() {
                courseIdPreview.textContent =
                    courseIdInput.value.trim()
                    || "Not entered";

                titlePreview.textContent =
                    titleInput.value.trim()
                    || "New Course";

                creditsPreview.textContent =
                    creditsInput.value
                    || "0";
            }

            courseIdInput.addEventListener(
                "input",
                updatePreview);

            titleInput.addEventListener(
                "input",
                updatePreview);

            creditsInput.addEventListener(
                "input",
                updatePreview);

            updatePreview();
        });
    </script>
}