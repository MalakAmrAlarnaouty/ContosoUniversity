@model ContosoUniversity.Models.Course

@{
    ViewData["Title"] = "Create Course";
}

<div class="d-flex flex-column
    flex-md-row
    justify-content-between
    align-items-md-center
    gap-3
    mb-4">

    <div>
        <h2 class="mb-1">Create Course</h2>

        <p class="text-muted mb-0">
            Enter the information for the new course and select its department.
        </p>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Courses
    </a>
</div>

<div class="row justify-content-center">

    <div class="col-lg-9">

        <form asp-action="Create"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <!-- Course information card -->
            <div class="card shadow-sm mb-4">

                <div class="card-header">
                    <strong>Course Information</strong>
                </div>

                <div class="card-body">

                    <div class="row">

                        <!-- Course ID -->
                        <div class="col-md-6 mb-4">

                            <label asp-for="CourseID"
                                   class="form-label">
                            </label>

                            <input asp-for="CourseID"
                                   type="number"
                                   min="1"
                                   max="99999"
                                   class="form-control"
                                   placeholder="Example: 1050" />

                            <span asp-validation-for="CourseID"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                The course ID must be unique.
                            </div>

                        </div>

                        <!-- Credits -->
                        <div class="col-md-6 mb-4">

                            <label asp-for="Credits"
                                   class="form-label">
                            </label>

                            <input asp-for="Credits"
                                   type="number"
                                   min="1"
                                   max="10"
                                   class="form-control" />

                            <span asp-validation-for="Credits"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Credits must be between 1 and 10.
                            </div>

                        </div>

                        <!-- Course title -->
                        <div class="col-md-6 mb-4">

                            <label asp-for="Title"
                                   class="form-label">
                            </label>

                            <input asp-for="Title"
                                   class="form-control"
                                   placeholder="Example: Introduction to Programming" />

                            <span asp-validation-for="Title"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Department -->
                        <div class="col-md-6 mb-4">

                            <label asp-for="DepartmentID"
                                   class="form-label">
                                Department
                            </label>

                            <select asp-for="DepartmentID"
                                    asp-items="ViewBag.Departments"
                                    class="form-select">

                                <option value="">
                                    Select a department
                                </option>

                            </select>

                            <span asp-validation-for="DepartmentID"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Select the department responsible for this course.
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Live preview card -->
            <div class="card shadow-sm mb-4">

                <div class="card-header">
                    <strong>Course Preview</strong>
                </div>

                <div class="card-body">

                    <div class="card border-primary">

                        <div class="card-body">

                            <div class="d-flex
                                justify-content-between
                                align-items-start
                                gap-3
                                mb-3">

                                <div>

                                    <h4 id="courseTitlePreview"
                                        class="card-title mb-1">
                                        New Course
                                    </h4>

                                    <span class="text-muted">
                                        Course ID:

                                        <span id="courseIdPreview">
                                            Not entered
                                        </span>
                                    </span>

                                </div>

                                <span class="badge bg-primary">
                                    New
                                </span>

                            </div>

                            <hr />

                            <div class="row text-center">

                                <!-- Credits preview -->
                                <div class="col-md-4 mb-3 mb-md-0">

                                    <small class="text-muted d-block">
                                        Credits
                                    </small>

                                    <strong id="courseCreditsPreview">
                                        3
                                    </strong>

                                </div>

                                <!-- Department preview -->
                                <div class="col-md-4 mb-3 mb-md-0">

                                    <small class="text-muted d-block">
                                        Department
                                    </small>

                                    <strong id="courseDepartmentPreview">
                                        No department selected
                                    </strong>

                                </div>

                                <!-- Student count preview -->
                                <div class="col-md-4">

                                    <small class="text-muted d-block">
                                        Enrolled Students
                                    </small>

                                    <strong>
                                        0
                                    </strong>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="d-flex gap-2 mb-4">

                <button type="submit"
                        class="btn btn-primary">
                    Create Course
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function() {

                const courseIdInput =
                    document.getElementById("CourseID");

                const titleInput =
                    document.getElementById("Title");

                const creditsInput =
                    document.getElementById("Credits");

                const departmentInput =
                    document.getElementById("DepartmentID");

                const courseIdPreview =
                    document.getElementById(
                        "courseIdPreview"
                    );

                const titlePreview =
                    document.getElementById(
                        "courseTitlePreview"
                    );

                const creditsPreview =
                    document.getElementById(
                        "courseCreditsPreview"
                    );

                const departmentPreview =
                    document.getElementById(
                        "courseDepartmentPreview"
                    );

                function updatePreview() {

                    courseIdPreview.textContent =
                        courseIdInput.value.trim()
                        || "Not entered";

                    titlePreview.textContent =
                        titleInput.value.trim()
                        || "New Course";

                    creditsPreview.textContent =
                        creditsInput.value
                        || "0";

                    const selectedDepartment =
                        departmentInput.options[
                        departmentInput.selectedIndex
                        ];

                    departmentPreview.textContent =
                        departmentInput.value
                            ? selectedDepartment.text
                            : "No department selected";
                }

                courseIdInput.addEventListener(
                    "input",
                    updatePreview
                );

                titleInput.addEventListener(
                    "input",
                    updatePreview
                );

                creditsInput.addEventListener(
                    "input",
                    updatePreview
                );

                departmentInput.addEventListener(
                    "change",
                    updatePreview
                );

                updatePreview();
            }
        );
    </script>
}