@{
    ViewData["Title"] = "About";
}

<div class="row justify-content-center">

    <div class="col-lg-9">

        <div class="text-center mb-4">

            <div class="rounded-circle
                bg-primary
                text-white
                d-flex
                align-items-center
                justify-content-center
                mx-auto
                mb-3"
                 style="width: 90px;
                height: 90px;
                font-size: 38px;">

                KFH
            </div>

            <h1 class="mb-2">
                About This Project
            </h1>

            <p class="text-muted">
                Contoso University Management System
            </p>

        </div>

        <div class="card shadow-sm mb-4">

            <div class="card-body p-4">

                <h4 class="mb-3">
                    Internship Project
                </h4>

                <p>
                    This project was developed during my internship at
                    <strong>Kuwait Finance House (KFH)</strong>.
                </p>

                <p>
                    The project is an ASP.NET Core MVC web application
                    designed to manage university students, courses,
                    enrollments, and grades.
                </p>

                <p class="mb-0">
                    It was created as a practical learning project to apply
                    concepts such as C#, ASP.NET Core MVC, Entity Framework
                    Core, SQL Server, Bootstrap, validation, database
                    relationships, and GitHub version control.
                </p>

            </div>

        </div>

        <div class="row">

            <div class="col-md-6 mb-4">

                <div class="card shadow-sm h-100">

                    <div class="card-header">
                        <strong>Project Features</strong>
                    </div>

                    <div class="card-body">

                        <ul class="mb-0">

                            <li class="mb-2">
                                Create, edit, view, and delete students
                            </li>

                            <li class="mb-2">
                                Create and manage courses
                            </li>

                            <li class="mb-2">
                                Assign students to courses
                            </li>

                            <li class="mb-2">
                                Manage student grades
                            </li>

                            <li class="mb-2">
                                Display course statistics
                            </li>

                            <li>
                                Search and paginate student and course tables
                            </li>

                        </ul>

                    </div>

                </div>

            </div>

            <div class="col-md-6 mb-4">

                <div class="card shadow-sm h-100">

                    <div class="card-header">
                        <strong>Technologies Used</strong>
                    </div>

                    <div class="card-body">

                        <div class="d-flex flex-wrap gap-2">

                            <span class="badge bg-primary p-2">
                                C#
                            </span>

                            <span class="badge bg-primary p-2">
                                ASP.NET Core MVC
                            </span>

                            <span class="badge bg-primary p-2">
                                Entity Framework Core
                            </span>

                            <span class="badge bg-primary p-2">
                                SQL Server
                            </span>

                            <span class="badge bg-primary p-2">
                                Razor
                            </span>

                            <span class="badge bg-primary p-2">
                                Bootstrap
                            </span>

                            <span class="badge bg-primary p-2">
                                JavaScript
                            </span>

                            <span class="badge bg-primary p-2">
                                GitHub
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

      

       

    </div>

</div>
