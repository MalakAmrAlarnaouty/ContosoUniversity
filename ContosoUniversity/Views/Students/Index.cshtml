@model IEnumerable<ContosoUniversity.Models.Student>
@using ContosoUniversity.Models

@{
    ViewData["Title"] = "Index";

    List<Course> allCourses =
        ViewBag.AllCourses as List<Course>
        ?? new List<Course>();
}

<h2>Index</h2>

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] is not null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<p>
    <a asp-action="Create"
       class="btn btn-primary">
        Create New
    </a>
</p>

<div class="table-responsive">
    <table class="table table-hover">
        <thead class="table-light">
            <tr>
                <th>Last Name</th>
                <th>First Name</th>
                <th>Enrollment Date</th>
                <th>Courses</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var student in Model)
            {
                <tr>
                    <td>@student.LastName</td>

                    <td>@student.FirstMidName</td>

                    <td>
                        @(student.EnrollmentDate.ToString("MM/dd/yyyy"))
                    </td>

                    <td>
                        <span class="badge bg-secondary">
                            @student.Enrollments.Count
                        </span>
                    </td>

                    <td>
                        <button type="button"
                                class="btn btn-link p-0 align-baseline"
                                data-bs-toggle="modal"
                                data-bs-target="#detailsModal-@student.ID">
                            Details
                        </button>

                        <span>|</span>

                        <button type="button"
                                class="btn btn-link text-danger p-0 align-baseline"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteModal-@student.ID">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@foreach (var student in Model)
{
    HashSet<int> selectedCourseIds = student.Enrollments
        .Select(enrollment => enrollment.CourseID)
        .ToHashSet();

    <!-- Details and Edit modal -->
    <div class="modal fade student-modal"
         id="detailsModal-@student.ID"
         data-student-id="@student.ID"
         tabindex="-1"
         aria-labelledby="detailsModalLabel-@student.ID"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title"
                        id="detailsModalLabel-@student.ID">
                        Student Details
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">

                    <!-- Details section -->
                    <div id="detailsView-@student.ID">

                        <div class="text-center mb-4">
                            <div class="rounded-circle
                                bg-primary
                                text-white
                                d-flex
                                align-items-center
                                justify-content-center
                                mx-auto
                                mb-3"
                                 style="width: 80px;
                                height: 80px;
                                font-size: 32px;">

                                @(string.IsNullOrWhiteSpace(
                                    student.FirstMidName)
                                    ? "?"
                                    : student.FirstMidName
                                        .Substring(0, 1)
                                        .ToUpper())
                            </div>

                            <h4>
                                @student.FirstMidName
                                @student.LastName
                            </h4>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-4 mb-2">
                                <strong>Student ID</strong>
                                <div>@student.ID</div>
                            </div>

                            <div class="col-md-4 mb-2">
                                <strong>Enrollment Date</strong>
                                <div>
                                    @(student.EnrollmentDate
                                        .ToString("MM/dd/yyyy"))
                                </div>
                            </div>

                            <div class="col-md-4 mb-2">
                                <strong>Total Courses</strong>
                                <div>
                                    @student.Enrollments.Count
                                </div>
                            </div>
                        </div>

                        <h5>Enrolled Courses</h5>

                        @if (student.Enrollments.Count == 0)
                        {
                            <div class="alert alert-secondary mb-0">
                                This student is not enrolled in any courses.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-striped align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Course ID</th>
                                            <th>Course Name</th>
                                            <th>Credits</th>
                                            <th>Grade</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (
                                            var enrollment in
                                            student.Enrollments
                                                .OrderBy(enrollment =>
                                                    enrollment.Course.Title))
                                        {
                                            <tr>
                                                <td>
                                                    @enrollment.CourseID
                                                </td>

                                                <td>
                                                    @enrollment.Course.Title
                                                </td>

                                                <td>
                                                    @enrollment.Course.Credits
                                                </td>

                                                <td>
                                                    @if (enrollment.Grade.HasValue)
                                                    {
                                                        <span class="badge bg-success">
                                                            @enrollment.Grade.Value
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">
                                                            Not graded
                                                        </span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                    <!-- Edit section -->
                    <div id="editView-@student.ID"
                         class="d-none">

                        <form id="editForm-@student.ID"
                              asp-action="Edit"
                              asp-route-id="@student.ID"
                              method="post">

                            <input type="hidden"
                                   name="ID"
                                   value="@student.ID" />

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">
                                        First Name
                                    </label>

                                    <input type="text"
                                           name="FirstMidName"
                                           value="@student.FirstMidName"
                                           class="form-control"
                                           required />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">
                                        Last Name
                                    </label>

                                    <input type="text"
                                           name="LastName"
                                           value="@student.LastName"
                                           class="form-control"
                                           required />
                                </div>

                                <div class="col-md-6 mb-4">
                                    <label class="form-label">
                                        Enrollment Date
                                    </label>

                                    <input type="date"
                                           name="EnrollmentDate"
                                           value="@(student.EnrollmentDate.ToString("yyyy-MM-dd"))"
                                           class="form-control"
                                           required />
                                </div>
                            </div>

                            <h5>Select Courses</h5>

                            <p class="text-muted">
                                Check or uncheck courses to update
                                this student's enrollments.
                            </p>

                            @if (allCourses.Count == 0)
                            {
                                <div class="alert alert-secondary">
                                    No courses are available.
                                </div>
                            }
                            else
                            {
                                <div class="row g-3">
                                    @foreach (var course in allCourses)
                                    {
                                        bool isSelected =
                                            selectedCourseIds.Contains(
                                                course.CourseID);

                                        string checkboxId =
                                            $"student-{student.ID}-course-{course.CourseID}";

                                        <div class="col-md-6">
                                            <input type="checkbox"
                                                   class="course-checkbox"
                                                   id="@checkboxId"
                                                   name="SelectedCourseIds"
                                                   value="@course.CourseID"
                                                   checked="@(isSelected ? "checked" : null)" />

                                            <label for="@checkboxId"
                                                   class="card course-selection-card h-100">

                                                <div class="card-body">
                                                    <div class="d-flex
                                                        justify-content-between
                                                        align-items-start
                                                        mb-3">

                                                        <div>
                                                            <h6 class="mb-1">
                                                                @course.Title
                                                            </h6>

                                                            <small class="text-muted">
                                                                Course ID:
                                                                @course.CourseID
                                                            </small>
                                                        </div>

                                                        <span class="badge
                                                            bg-primary
                                                            selected-badge">
                                                            Selected
                                                        </span>
                                                    </div>

                                                    <div class="d-flex
                                                        justify-content-between
                                                        border-top
                                                        pt-3">

                                                        <div>
                                                            <small class="text-muted d-block">
                                                                Credits
                                                            </small>

                                                            <strong>
                                                                @course.Credits
                                                            </strong>
                                                        </div>

                                                        <div class="text-end">
                                                            <small class="text-muted d-block">
                                                                Students
                                                            </small>

                                                            <strong>
                                                                @course.Enrollments.Count
                                                            </strong>
                                                        </div>
                                                    </div>
                                                </div>
                                            </label>
                                        </div>
                                    }
                                </div>
                            }
                        </form>
                    </div>
                </div>

                <div class="modal-footer">

                    <div id="detailsButtons-@student.ID">
                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Close
                        </button>

                        <button type="button"
                                class="btn btn-primary"
                                onclick="showEditForm(@student.ID)">
                            Edit Student
                        </button>
                    </div>

                    <div id="editButtons-@student.ID"
                         class="d-none">

                        <button type="button"
                                class="btn btn-secondary"
                                onclick="showStudentDetails(@student.ID)">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn btn-success"
                                form="editForm-@student.ID">
                            Save Changes
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete modal -->
    <div class="modal fade"
         id="deleteModal-@student.ID"
         tabindex="-1"
         aria-labelledby="deleteModalLabel-@student.ID"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title"
                        id="deleteModalLabel-@student.ID">
                        Delete Student
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    Are you sure you want to delete
                    <strong>
                        @student.FirstMidName
                        @student.LastName
                    </strong>?
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <form asp-action="Delete"
                          asp-route-id="@student.ID"
                          method="post">

                        <button type="submit"
                                class="btn btn-danger">
                            Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .course-checkbox {
        position: absolute;
        opacity: 0;
    }

    .course-selection-card {
        cursor: pointer;
        border: 2px solid transparent;
        transition: border-color 0.15s ease, background-color 0.15s ease, transform 0.15s ease;
    }

        .course-selection-card:hover {
            border-color: var(--bs-primary);
            transform: translateY(-2px);
        }

    .selected-badge {
        visibility: hidden;
    }

    .course-checkbox:checked + .course-selection-card {
        border-color: var(--bs-primary);
        background-color: rgba(var(--bs-primary-rgb), 0.08);
    }

        .course-checkbox:checked + .course-selection-card
        .selected-badge {
            visibility: visible;
        }

    .course-checkbox:focus-visible + .course-selection-card {
        outline: 3px solid rgba(var(--bs-primary-rgb), 0.35);
        outline-offset: 2px;
    }
</style>

@section Scripts {
    <script>
        function showEditForm(studentId) {
            document
                .getElementById(`detailsView-${studentId}`)
                .classList.add("d-none");

            document
                .getElementById(`detailsButtons-${studentId}`)
                .classList.add("d-none");

            document
                .getElementById(`editView-${studentId}`)
                .classList.remove("d-none");

            document
                .getElementById(`editButtons-${studentId}`)
                .classList.remove("d-none");
        }

        function showStudentDetails(studentId) {
            document
                .getElementById(`editView-${studentId}`)
                .classList.add("d-none");

            document
                .getElementById(`editButtons-${studentId}`)
                .classList.add("d-none");

            document
                .getElementById(`detailsView-${studentId}`)
                .classList.remove("d-none");

            document
                .getElementById(`detailsButtons-${studentId}`)
                .classList.remove("d-none");
        }

        document
            .querySelectorAll(".student-modal")
            .forEach(function(modalElement) {
                modalElement.addEventListener(
                    "hidden.bs.modal",
                    function() {
                        showStudentDetails(
                            modalElement.dataset.studentId);
                    });
            });
    </script>
}