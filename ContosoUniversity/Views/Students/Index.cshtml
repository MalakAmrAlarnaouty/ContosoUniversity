@model IEnumerable<ContosoUniversity.Models.Student>
@using ContosoUniversity.Models

@{
    ViewData["Title"] = "Students";

    List<Course> allCourses =
        ViewBag.AllCourses as List<Course>
        ?? new List<Course>();

    List<Department> allDepartments =
        ViewBag.AllDepartments as List<Department>
        ?? new List<Department>();

    var students = Model.ToList();
}

<div class="d-flex flex-column
            flex-md-row
            justify-content-between
            align-items-md-center
            gap-3
            mb-4">

    <div>
        <h2 class="mb-1">Students</h2>

        <p class="text-muted mb-0">
            View and manage students, departments, courses, and grades.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        Create New Student
    </a>

</div>

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>

    </div>
}

@if (TempData["ErrorMessage"] is not null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">

        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>

    </div>
}

@if (students.Count == 0)
{
    <div class="alert alert-secondary">

        No students are currently available.

        <a asp-action="Create"
           class="alert-link">
            Create the first student
        </a>.

    </div>
}
else
{
    <div class="card shadow-sm mb-4">

        <div class="card-header d-flex
                    flex-column
                    flex-md-row
                    justify-content-between
                    align-items-md-center
                    gap-3">

            <strong>Student List</strong>

            <div style="width: 100%; max-width: 340px;">

                <input type="search"
                       id="studentSearch"
                       class="form-control"
                       placeholder="Search students or departments..."
                       aria-label="Search students" />

            </div>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table id="studentTable"
                       class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>Student ID</th>
                            <th>Last Name</th>
                            <th>First Name</th>
                            <th>Department</th>
                            <th>Enrollment Date</th>
                            <th>Courses</th>
                            <th>Actions</th>
                        </tr>

                    </thead>

                    <tbody id="studentTableBody">

                        @foreach (var student in students)
                        {
                            string departmentName =
                                student.Department?.Name
                                ?? "Not assigned";

                            string studentSearchValue =
                                $"{student.ID} " +
                                $"{student.FirstMidName} " +
                                $"{student.LastName} " +
                                $"{departmentName} " +
                                $"{student.EnrollmentDate:MM/dd/yyyy} " +
                                $"{student.Enrollments.Count}";

                            <tr class="student-row"
                                data-search="@studentSearchValue.ToLowerInvariant()">

                                <td>
                                    @student.ID
                                </td>

                                <td>
                                    @student.LastName
                                </td>

                                <td>
                                    @student.FirstMidName
                                </td>

                                <td>

                                    @if (student.Department is not null)
                                    {
                                        <span class="badge bg-info text-dark">
                                            @student.Department.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Not assigned
                                        </span>
                                    }

                                </td>

                                <td>
                                    @student.EnrollmentDate.ToString("MM/dd/yyyy")
                                </td>

                                <td>
                                    <span class="badge bg-secondary rounded-pill">
                                        @student.Enrollments.Count
                                    </span>
                                </td>

                                <td>

                                    <button type="button"
                                            class="btn btn-link p-0 align-baseline"
                                            data-bs-toggle="modal"
                                            data-bs-target="#detailsModal-@student.ID">

                                        Details
                                    </button>

                                    <span>|</span>

                                    <button type="button"
                                            class="btn btn-link text-danger p-0 align-baseline"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteModal-@student.ID">

                                        Delete
                                    </button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div id="noStudentResults"
                 class="alert alert-secondary m-3 d-none">

                No students match your search.

            </div>

            <div class="d-flex
                        flex-column
                        flex-md-row
                        justify-content-end
                        align-items-md-center
                        gap-3
                        border-top
                        p-3">

                <div class="d-flex align-items-center gap-2">

                    <label for="studentRowsPerPage"
                           class="text-muted text-nowrap">
                        Rows per page:
                    </label>

                    <input type="number"
                           id="studentRowsPerPage"
                           class="form-control form-control-sm"
                           value="10"
                           min="1"
                           step="1"
                           style="width: 90px;"
                           aria-label="Number of students per page" />

                </div>

                <span id="studentPageInformation"
                      class="text-muted text-nowrap">
                </span>

                <span id="studentPageNumber"
                      class="text-muted text-nowrap">
                </span>

                <div class="btn-group"
                     role="group"
                     aria-label="Student pagination">

                    <button type="button"
                            id="previousStudentPage"
                            class="btn btn-sm btn-outline-secondary"
                            aria-label="Previous page">

                        &lsaquo;
                    </button>

                    <button type="button"
                            id="nextStudentPage"
                            class="btn btn-sm btn-outline-secondary"
                            aria-label="Next page">

                        &rsaquo;
                    </button>

                </div>

            </div>

        </div>

    </div>
}

@foreach (var student in students)
{
    <!-- Details and edit modal -->
    <div class="modal fade student-modal"
         id="detailsModal-@student.ID"
         data-student-id="@student.ID"
         tabindex="-1"
         aria-labelledby="detailsModalLabel-@student.ID"
         aria-hidden="true">

        <div class="modal-dialog
                    modal-dialog-centered
                    modal-dialog-scrollable
                    modal-xl">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title"
                        id="detailsModalLabel-@student.ID">

                        Student Details
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>

                <div class="modal-body">

                    <!-- Details view -->
                    <div id="detailsView-@student.ID">

                        <div class="text-center mb-4">

                            <div class="rounded-circle
                                        bg-primary
                                        text-white
                                        d-flex
                                        align-items-center
                                        justify-content-center
                                        mx-auto
                                        mb-3"
                                 style="width: 80px;
                                        height: 80px;
                                        font-size: 32px;">

                                @(string.IsNullOrWhiteSpace(student.FirstMidName)
                                    ? "?"
                                    : student.FirstMidName
                                        .Substring(0, 1)
                                        .ToUpper())

                            </div>

                            <h4 class="mb-1">

                                @student.FirstMidName
                                @student.LastName

                            </h4>

                            <span class="text-muted">
                                Student ID: @student.ID
                            </span>

                        </div>

                        <div class="row mb-4">

                            <div class="col-sm-6 col-lg-3 mb-3">

                                <div class="card h-100 text-center">

                                    <div class="card-body">

                                        <h6 class="text-muted">
                                            Student ID
                                        </h6>

                                        <h4 class="mb-0">
                                            @student.ID
                                        </h4>

                                    </div>

                                </div>

                            </div>

                            <div class="col-sm-6 col-lg-3 mb-3">

                                <div class="card h-100 text-center">

                                    <div class="card-body">

                                        <h6 class="text-muted">
                                            Department
                                        </h6>

                                        <h5 class="mb-0">
                                            @(student.Department?.Name
                                                ?? "Not assigned")
                                        </h5>

                                    </div>

                                </div>

                            </div>

                            <div class="col-sm-6 col-lg-3 mb-3">

                                <div class="card h-100 text-center">

                                    <div class="card-body">

                                        <h6 class="text-muted">
                                            Enrollment Date
                                        </h6>

                                        <h5 class="mb-0">
                                            @student.EnrollmentDate.ToString("MM/dd/yyyy")
                                        </h5>

                                    </div>

                                </div>

                            </div>

                            <div class="col-sm-6 col-lg-3 mb-3">

                                <div class="card h-100 text-center">

                                    <div class="card-body">

                                        <h6 class="text-muted">
                                            Total Courses
                                        </h6>

                                        <h4 class="mb-0">
                                            @student.Enrollments.Count
                                        </h4>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <h5>Enrolled Courses</h5>

                        @if (student.Enrollments.Count == 0)
                        {
                            <div class="alert alert-secondary mb-0">

                                This student is not enrolled in any courses.

                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">

                                <table class="table
                                              table-striped
                                              align-middle
                                              mb-0">

                                    <thead class="table-light">

                                        <tr>
                                            <th>Course ID</th>
                                            <th>Course Name</th>
                                            <th>Department</th>
                                            <th>Credits</th>
                                            <th>Grade</th>
                                        </tr>

                                    </thead>

                                    <tbody>

                                        @foreach (
                                            var enrollment in
                                            student.Enrollments
                                                .OrderBy(enrollment =>
                                                    enrollment.Course.Title))
                                        {
                                            <tr>

                                                <td>
                                                    @enrollment.CourseID
                                                </td>

                                                <td>
                                                    @enrollment.Course.Title
                                                </td>

                                                <td>
                                                    @(enrollment.Course.Department?.Name
                                                        ?? student.Department?.Name
                                                        ?? "Not assigned")
                                                </td>

                                                <td>
                                                    @enrollment.Course.Credits
                                                </td>

                                                <td>

                                                    @if (enrollment.Grade.HasValue)
                                                    {
                                                        <span class="badge bg-success">
                                                            @enrollment.Grade.Value
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">
                                                            Not graded
                                                        </span>
                                                    }

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>
                        }

                    </div>

                    <!-- Edit view -->
                    <div id="editView-@student.ID"
                         class="d-none">

                        <form id="editForm-@student.ID"
                              asp-action="Edit"
                              asp-route-id="@student.ID"
                              method="post">

                            <input type="hidden"
                                   name="ID"
                                   value="@student.ID" />

                            <div class="card shadow-sm mb-4">

                                <div class="card-header">
                                    <strong>Student Information</strong>
                                </div>

                                <div class="card-body">

                                    <div class="row">

                                        <div class="col-md-6 mb-3">

                                            <label for="firstName-@student.ID"
                                                   class="form-label">
                                                First Name
                                            </label>

                                            <input type="text"
                                                   id="firstName-@student.ID"
                                                   name="FirstMidName"
                                                   value="@student.FirstMidName"
                                                   class="form-control"
                                                   required />

                                        </div>

                                        <div class="col-md-6 mb-3">

                                            <label for="lastName-@student.ID"
                                                   class="form-label">
                                                Last Name
                                            </label>

                                            <input type="text"
                                                   id="lastName-@student.ID"
                                                   name="LastName"
                                                   value="@student.LastName"
                                                   class="form-control"
                                                   required />

                                        </div>

                                        <div class="col-md-6 mb-3">

                                            <label for="enrollmentDate-@student.ID"
                                                   class="form-label">
                                                Enrollment Date
                                            </label>

                                            <input type="date"
                                                   id="enrollmentDate-@student.ID"
                                                   name="EnrollmentDate"
                                                   value="@student.EnrollmentDate.ToString("yyyy-MM-dd")"
                                                   class="form-control"
                                                   required />

                                        </div>

                                        <div class="col-md-6 mb-3">

                                            <label for="departmentSelect-@student.ID"
                                                   class="form-label">

                                                Faculty / Department
                                            </label>

                                            <select id="departmentSelect-@student.ID"
                                                    name="DepartmentID"
                                                    class="form-select
                                                           student-department-select"
                                                    data-student-id="@student.ID"
                                                    required>

                                                <option value="">
                                                    Select faculty or department
                                                </option>

                                                @foreach (
                                                    var department in
                                                    allDepartments)
                                                {
                                                    <option value="@department.DepartmentID"
                                                            selected="@(student.DepartmentID ==
                                                                department.DepartmentID
                                                                    ? "selected"
                                                                    : null)">

                                                        @department.Name
                                                    </option>
                                                }

                                            </select>

                                        </div>

                                    </div>

                                </div>

                            </div>

                            <div class="card shadow-sm">

                                <div class="card-header">
                                    <strong>Courses and Grades</strong>
                                </div>

                                <div class="card-body">

                                    <p class="text-muted">

                                        Only courses assigned to the selected
                                        department are available.

                                    </p>

                                    <div id="selectEditDepartment-@student.ID"
                                         class="alert alert-info d-none">

                                        Select a department to view its courses.

                                    </div>

                                    <div id="noEditCourses-@student.ID"
                                         class="alert alert-warning d-none">

                                        No courses are assigned to the selected
                                        department.

                                    </div>

                                    @if (allCourses.Count == 0)
                                    {
                                        <div class="alert alert-secondary mb-0">

                                            No courses are currently available.

                                        </div>
                                    }
                                    else
                                    {
                                        <div class="row g-3">

                                            @foreach (var course in allCourses)
                                            {
                                                var currentEnrollment =
                                                    student.Enrollments
                                                        .FirstOrDefault(enrollment =>
                                                            enrollment.CourseID ==
                                                            course.CourseID);

                                                bool isSelected =
                                                    currentEnrollment is not null;

                                                string checkboxId =
                                                    $"student-{student.ID}-course-{course.CourseID}";

                                                string gradeSelectId =
                                                    $"grade-{student.ID}-{course.CourseID}";

                                                <div class="col-md-6
                                                            col-xl-4
                                                            student-course-option
                                                            student-@student.ID-course-option"
                                                     data-department-id="@(course.DepartmentID?.ToString()
                                                        ?? string.Empty)">

                                                    <input type="checkbox"
                                                           class="course-checkbox
                                                                  edit-course-checkbox
                                                                  visually-hidden"
                                                           id="@checkboxId"
                                                           name="SelectedCourseIds"
                                                           value="@course.CourseID"
                                                           data-grade-select-id="@gradeSelectId"
                                                           data-student-id="@student.ID"
                                                           checked="@(isSelected
                                                               ? "checked"
                                                               : null)" />

                                                    <div class="card
                                                                course-selection-card
                                                                h-100">

                                                        <label for="@checkboxId"
                                                               class="card-body
                                                                      course-card-label">

                                                            <div class="d-flex
                                                                        justify-content-between
                                                                        align-items-start
                                                                        gap-2
                                                                        mb-3">

                                                                <div>

                                                                    <h6 class="mb-1">
                                                                        @course.Title
                                                                    </h6>

                                                                    <small class="text-muted">

                                                                        Course ID:
                                                                        @course.CourseID

                                                                    </small>

                                                                </div>

                                                                <span class="badge
                                                                             bg-primary
                                                                             selected-badge">

                                                                    Selected
                                                                </span>

                                                            </div>

                                                            <div class="mb-3">

                                                                <small class="text-muted d-block">
                                                                    Department
                                                                </small>

                                                                <strong>
                                                                    @(course.Department?.Name
                                                                        ?? "Not assigned")
                                                                </strong>

                                                            </div>

                                                            <div class="row border-top pt-3">

                                                                <div class="col-6">

                                                                    <small class="text-muted d-block">
                                                                        Credits
                                                                    </small>

                                                                    <strong>
                                                                        @course.Credits
                                                                    </strong>

                                                                </div>

                                                                <div class="col-6 text-end">

                                                                    <small class="text-muted d-block">
                                                                        Students
                                                                    </small>

                                                                    <strong>
                                                                        @course.Enrollments.Count
                                                                    </strong>

                                                                </div>

                                                            </div>

                                                        </label>

                                                        <div class="card-footer bg-transparent">

                                                            <label for="@gradeSelectId"
                                                                   class="form-label">

                                                                Student Grade
                                                            </label>

                                                            <select id="@gradeSelectId"
                                                                    name="EnrollmentGrades[@course.CourseID]"
                                                                    class="form-select
                                                                           course-grade-select"
                                                                    disabled="@(!isSelected
                                                                        ? "disabled"
                                                                        : null)">

                                                                <option value="">
                                                                    Not graded
                                                                </option>

                                                                @foreach (
                                                                    Grade grade in
                                                                    Enum.GetValues<Grade>())
                                                                {
                                                                    bool gradeSelected =
                                                                        currentEnrollment?.Grade ==
                                                                        grade;

                                                                    <option value="@grade"
                                                                            selected="@(gradeSelected
                                                                                ? "selected"
                                                                                : null)">

                                                                        @grade
                                                                    </option>
                                                                }

                                                            </select>

                                                        </div>

                                                    </div>

                                                </div>
                                            }

                                        </div>
                                    }

                                </div>

                            </div>

                        </form>

                    </div>

                </div>

                <div class="modal-footer">

                    <div id="detailsButtons-@student.ID">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">

                            Close
                        </button>

                        <button type="button"
                                class="btn btn-primary"
                                onclick="showEditForm(@student.ID)">

                            Edit Student
                        </button>

                    </div>

                    <div id="editButtons-@student.ID"
                         class="d-none">

                        <button type="button"
                                class="btn btn-secondary"
                                onclick="cancelStudentEdit(@student.ID)">

                            Cancel
                        </button>

                        <button type="submit"
                                class="btn btn-success"
                                form="editForm-@student.ID">

                            Save Changes
                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Delete confirmation modal -->
    <div class="modal fade"
         id="deleteModal-@student.ID"
         tabindex="-1"
         aria-labelledby="deleteModalLabel-@student.ID"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title"
                        id="deleteModalLabel-@student.ID">

                        Delete Student
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>

                <div class="modal-body">

                    Are you sure you want to delete

                    <strong>
                        @student.FirstMidName
                        @student.LastName
                    </strong>?

                    <p class="text-danger mt-3 mb-0">

                        All of this student's course enrollments and
                        grades will also be deleted.

                    </p>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancel
                    </button>

                    <form asp-action="Delete"
                          asp-route-id="@student.ID"
                          method="post">

                        <button type="submit"
                                class="btn btn-danger">

                            Delete Student
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>
}

<style>
    .course-selection-card {
        border: 2px solid transparent;
        transition:
            border-color 0.15s ease,
            background-color 0.15s ease,
            transform 0.15s ease;
    }

    .course-card-label {
        display: block;
        cursor: pointer;
    }

    .course-selection-card:hover {
        border-color: var(--bs-primary);
        transform: translateY(-2px);
    }

    .selected-badge {
        visibility: hidden;
    }

    .course-checkbox:checked + .course-selection-card {
        border-color: var(--bs-primary);
        background-color:
            rgba(var(--bs-primary-rgb), 0.08);
    }

    .course-checkbox:checked
    + .course-selection-card
    .selected-badge {
        visibility: visible;
    }

    .course-checkbox:focus-visible
    + .course-selection-card {
        outline: 3px solid
            rgba(var(--bs-primary-rgb), 0.35);

        outline-offset: 2px;
    }

    .course-grade-select:disabled {
        cursor: not-allowed;
        opacity: 0.65;
    }
</style>

@section Scripts {
    <script>
        function updateGradeSelect(
            courseCheckbox,
            clearGradeWhenUnchecked) {

            const gradeSelectId =
                courseCheckbox.dataset.gradeSelectId;

            const gradeSelect =
                document.getElementById(
                    gradeSelectId
                );

            if (!gradeSelect) {
                return;
            }

            gradeSelect.disabled =
                courseCheckbox.disabled ||
                !courseCheckbox.checked;

            if (
                !courseCheckbox.checked &&
                clearGradeWhenUnchecked
            ) {
                gradeSelect.value = "";
            }
        }

        function filterStudentEditCourses(
            studentId,
            clearHiddenSelections) {

            const departmentSelect =
                document.getElementById(
                    `departmentSelect-${studentId}`
                );

            const noCoursesMessage =
                document.getElementById(
                    `noEditCourses-${studentId}`
                );

            const selectDepartmentMessage =
                document.getElementById(
                    `selectEditDepartment-${studentId}`
                );

            if (!departmentSelect) {
                return;
            }

            const selectedDepartmentId =
                departmentSelect.value;

            const courseOptions =
                document.querySelectorAll(
                    `.student-${studentId}-course-option`
                );

            let visibleCourseCount = 0;

            courseOptions.forEach(
                function (option) {

                    const courseDepartmentId =
                        option.dataset.departmentId || "";

                    const belongsToDepartment =
                        selectedDepartmentId !== "" &&
                        courseDepartmentId ===
                        selectedDepartmentId;

                    option.classList.toggle(
                        "d-none",
                        !belongsToDepartment
                    );

                    const checkbox =
                        option.querySelector(
                            ".edit-course-checkbox"
                        );

                    if (!checkbox) {
                        return;
                    }

                    checkbox.disabled =
                        !belongsToDepartment;

                    if (
                        !belongsToDepartment &&
                        clearHiddenSelections
                    ) {
                        checkbox.checked = false;
                    }

                    if (!belongsToDepartment) {
                        checkbox.checked = false;
                    }

                    updateGradeSelect(
                        checkbox,
                        !belongsToDepartment
                    );

                    if (belongsToDepartment) {
                        visibleCourseCount++;
                    }
                }
            );

            if (selectDepartmentMessage) {
                selectDepartmentMessage.classList.toggle(
                    "d-none",
                    selectedDepartmentId !== ""
                );
            }

            if (noCoursesMessage) {
                noCoursesMessage.classList.toggle(
                    "d-none",
                    selectedDepartmentId === "" ||
                    visibleCourseCount > 0
                );
            }
        }

        function showEditForm(studentId) {
            document
                .getElementById(
                    `detailsView-${studentId}`
                )
                .classList.add("d-none");

            document
                .getElementById(
                    `detailsButtons-${studentId}`
                )
                .classList.add("d-none");

            document
                .getElementById(
                    `editView-${studentId}`
                )
                .classList.remove("d-none");

            document
                .getElementById(
                    `editButtons-${studentId}`
                )
                .classList.remove("d-none");

            filterStudentEditCourses(
                studentId,
                false
            );
        }

        function showStudentDetails(studentId) {
            document
                .getElementById(
                    `editView-${studentId}`
                )
                .classList.add("d-none");

            document
                .getElementById(
                    `editButtons-${studentId}`
                )
                .classList.add("d-none");

            document
                .getElementById(
                    `detailsView-${studentId}`
                )
                .classList.remove("d-none");

            document
                .getElementById(
                    `detailsButtons-${studentId}`
                )
                .classList.remove("d-none");
        }

        function resetStudentEditForm(studentId) {
            const form =
                document.getElementById(
                    `editForm-${studentId}`
                );

            if (!form) {
                return;
            }

            form.reset();

            form
                .querySelectorAll(
                    ".edit-course-checkbox"
                )
                .forEach(function (checkbox) {

                    updateGradeSelect(
                        checkbox,
                        false
                    );
                });

            filterStudentEditCourses(
                studentId,
                false
            );
        }

        function cancelStudentEdit(studentId) {
            resetStudentEditForm(studentId);
            showStudentDetails(studentId);
        }

        document
            .querySelectorAll(
                ".edit-course-checkbox"
            )
            .forEach(function (checkbox) {

                checkbox.addEventListener(
                    "change",
                    function () {

                        updateGradeSelect(
                            checkbox,
                            true
                        );
                    }
                );
            });

        document
            .querySelectorAll(
                ".student-department-select"
            )
            .forEach(function (departmentSelect) {

                departmentSelect.addEventListener(
                    "change",
                    function () {

                        filterStudentEditCourses(
                            departmentSelect.dataset.studentId,
                            true
                        );
                    }
                );
            });

        document
            .querySelectorAll(".student-modal")
            .forEach(function (modalElement) {

                modalElement.addEventListener(
                    "hidden.bs.modal",
                    function () {

                        const studentId =
                            modalElement.dataset.studentId;

                        resetStudentEditForm(studentId);
                        showStudentDetails(studentId);
                    }
                );
            });

        // Student table pagination
        const studentTableBody =
            document.getElementById(
                "studentTableBody"
            );

        if (studentTableBody) {

            const allStudentRows = Array.from(
                studentTableBody.querySelectorAll(
                    ".student-row"
                )
            );

            const studentSearchInput =
                document.getElementById(
                    "studentSearch"
                );

            const studentRowsPerPageInput =
                document.getElementById(
                    "studentRowsPerPage"
                );

            const studentPageInformation =
                document.getElementById(
                    "studentPageInformation"
                );

            const studentPageNumber =
                document.getElementById(
                    "studentPageNumber"
                );

            const previousStudentButton =
                document.getElementById(
                    "previousStudentPage"
                );

            const nextStudentButton =
                document.getElementById(
                    "nextStudentPage"
                );

            const noStudentResults =
                document.getElementById(
                    "noStudentResults"
                );

            let currentStudentPage = 1;

            function getFilteredStudentRows() {
                const searchText =
                    studentSearchInput.value
                        .trim()
                        .toLowerCase();

                if (searchText === "") {
                    return allStudentRows;
                }

                return allStudentRows.filter(
                    function (row) {

                        const searchableValue =
                            row.dataset.search || "";

                        return searchableValue.includes(
                            searchText
                        );
                    }
                );
            }

            function getStudentRowsPerPage() {
                const enteredValue =
                    Number.parseInt(
                        studentRowsPerPageInput.value,
                        10
                    );

                if (
                    Number.isNaN(enteredValue) ||
                    enteredValue < 1
                ) {
                    return 1;
                }

                return enteredValue;
            }

            function renderStudentTable() {
                const filteredRows =
                    getFilteredStudentRows();

                const rowsPerPage =
                    getStudentRowsPerPage();

                const totalPages =
                    Math.max(
                        1,
                        Math.ceil(
                            filteredRows.length /
                            rowsPerPage
                        )
                    );

                if (currentStudentPage > totalPages) {
                    currentStudentPage = totalPages;
                }

                if (currentStudentPage < 1) {
                    currentStudentPage = 1;
                }

                allStudentRows.forEach(
                    function (row) {
                        row.classList.add("d-none");
                    }
                );

                if (filteredRows.length === 0) {

                    noStudentResults.classList.remove(
                        "d-none"
                    );

                    studentPageInformation.textContent =
                        "0 students";

                    studentPageNumber.textContent =
                        "Page 0 of 0";

                    previousStudentButton.disabled = true;
                    nextStudentButton.disabled = true;

                    return;
                }

                noStudentResults.classList.add(
                    "d-none"
                );

                const startIndex =
                    (currentStudentPage - 1) *
                    rowsPerPage;

                const endIndex =
                    Math.min(
                        startIndex + rowsPerPage,
                        filteredRows.length
                    );

                filteredRows
                    .slice(startIndex, endIndex)
                    .forEach(function (row) {

                        row.classList.remove(
                            "d-none"
                        );
                    });

                studentPageInformation.textContent =
                    `${startIndex + 1} - ` +
                    `${endIndex} of ` +
                    `${filteredRows.length}`;

                studentPageNumber.textContent =
                    `Page ${currentStudentPage} ` +
                    `of ${totalPages}`;

                previousStudentButton.disabled =
                    currentStudentPage === 1;

                nextStudentButton.disabled =
                    currentStudentPage === totalPages;
            }

            studentSearchInput.addEventListener(
                "input",
                function () {

                    currentStudentPage = 1;
                    renderStudentTable();
                }
            );

            studentRowsPerPageInput.addEventListener(
                "input",
                function () {

                    currentStudentPage = 1;
                    renderStudentTable();
                }
            );

            studentRowsPerPageInput.addEventListener(
                "change",
                function () {

                    if (
                        !studentRowsPerPageInput.value ||
                        Number(
                            studentRowsPerPageInput.value
                        ) < 1
                    ) {
                        studentRowsPerPageInput.value = 1;
                    }

                    currentStudentPage = 1;
                    renderStudentTable();
                }
            );

            previousStudentButton.addEventListener(
                "click",
                function () {

                    if (currentStudentPage > 1) {
                        currentStudentPage--;
                        renderStudentTable();
                    }
                }
            );

            nextStudentButton.addEventListener(
                "click",
                function () {

                    const filteredRows =
                        getFilteredStudentRows();

                    const rowsPerPage =
                        getStudentRowsPerPage();

                    const totalPages =
                        Math.max(
                            1,
                            Math.ceil(
                                filteredRows.length /
                                rowsPerPage
                            )
                        );

                    if (currentStudentPage < totalPages) {
                        currentStudentPage++;
                        renderStudentTable();
                    }
                }
            );

            renderStudentTable();
        }
    </script>
}