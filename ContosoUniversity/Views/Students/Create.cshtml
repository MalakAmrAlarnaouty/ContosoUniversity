@model ContosoUniversity.ViewModels.CreateStudentViewModel

@{
    ViewData["Title"] = "Create Student";
}

<h2>Create Student</h2>

<p class="text-muted">
    Enter the student information and select their courses.
</p>

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <strong>Student Information</strong>
        </div>

        <div class="card-body">
            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="FirstMidName"
                           class="form-label">
                    </label>

                    <input asp-for="FirstMidName"
                           class="form-control"
                           placeholder="Enter first name" />

                    <span asp-validation-for="FirstMidName"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="LastName"
                           class="form-label">
                    </label>

                    <input asp-for="LastName"
                           class="form-control"
                           placeholder="Enter last name" />

                    <span asp-validation-for="LastName"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="EnrollmentDate"
                           class="form-label">
                    </label>

                    <input asp-for="EnrollmentDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="EnrollmentDate"
                          class="text-danger">
                    </span>
                </div>

            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <strong>Select Courses</strong>
        </div>

        <div class="card-body">

            <p class="text-muted">
                Select one or more courses for this student.
            </p>

            <span asp-validation-for="SelectedCourseIds"
                  class="text-danger d-block mb-3">
            </span>

            @if (Model.Courses.Count == 0)
            {
                <div class="alert alert-secondary mb-0">
                    No courses are currently available.
                </div>
            }
            else
            {
                <div class="row g-3">

                    @foreach (var course in Model.Courses)
                    {
                        bool selected =
                            Model.SelectedCourseIds.Contains(
                                course.CourseID);

                        <div class="col-md-6 col-lg-4">

                            <input type="checkbox"
                                   class="course-checkbox"
                                   id="course-@course.CourseID"
                                   name="SelectedCourseIds"
                                   value="@course.CourseID"
                                   checked="@(selected ? "checked" : null)" />

                            <label for="course-@course.CourseID"
                                   class="card course-selection-card h-100">

                                <div class="card-body">

                                    <div class="d-flex
                                        justify-content-between
                                        align-items-start
                                        mb-3">

                                        <div>
                                            <h5 class="card-title mb-1">
                                                @course.Title
                                            </h5>

                                            <small class="text-muted">
                                                Course ID:
                                                @course.CourseID
                                            </small>
                                        </div>

                                        <span class="badge bg-primary
                                            selected-badge">
                                            Selected
                                        </span>
                                    </div>

                                    <div class="d-flex
                                        justify-content-between
                                        border-top
                                        pt-3">

                                        <div>
                                            <small class="text-muted
                                                d-block">
                                                Credits
                                            </small>

                                            <strong>
                                                @course.Credits
                                            </strong>
                                        </div>

                                        <div class="text-end">
                                            <small class="text-muted
                                                d-block">
                                                Students
                                            </small>

                                            <strong>
                                                @course.EnrolledStudentCount
                                            </strong>
                                        </div>

                                    </div>
                                </div>
                            </label>
                        </div>
                    }

                </div>
            }
        </div>
    </div>

    <div class="d-flex gap-2 mb-4">
        <button type="submit"
                class="btn btn-primary">
            Create Student
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>
    </div>

</form>

<style>
    .course-checkbox {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .course-selection-card {
        cursor: pointer;
        border: 2px solid transparent;
        transition:
            border-color 0.15s ease,
            background-color 0.15s ease,
            transform 0.15s ease;
    }

    .course-selection-card:hover {
        border-color: var(--bs-primary);
        transform: translateY(-2px);
    }

    .selected-badge {
        visibility: hidden;
    }

    .course-checkbox:checked + .course-selection-card {
        border-color: var(--bs-primary);
        background-color: rgba(
            var(--bs-primary-rgb),
            0.08
        );
    }

    .course-checkbox:checked
    + .course-selection-card
    .selected-badge {
        visibility: visible;
    }

    .course-checkbox:focus-visible
    + .course-selection-card {
        outline: 3px solid rgba(
            var(--bs-primary-rgb),
            0.35
        );

        outline-offset: 2px;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}