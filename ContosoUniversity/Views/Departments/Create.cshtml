@model ContosoUniversity.Models.Department

@{
    ViewData["Title"] = "Create Department";
}

<div class="d-flex flex-column
    flex-md-row
    justify-content-between
    align-items-md-center
    gap-3
    mb-4">

    <div>

        <h2 class="mb-1">
            Create Department
        </h2>

        <p class="text-muted mb-0">
            Enter the information for the new department.
        </p>

    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        Back to Departments
    </a>

</div>

<div class="row justify-content-center">

    <div class="col-lg-8">

        <form asp-action="Create"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="card shadow-sm mb-4">

                <div class="card-header">
                    <strong>Department Information</strong>
                </div>

                <div class="card-body">

                    <div class="mb-4">

                        <label asp-for="Name"
                               class="form-label">
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Example: Computer Science" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="StartDate"
                               class="form-label">
                        </label>

                        <input asp-for="StartDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="StartDate"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>

            <div class="card shadow-sm mb-4">

                <div class="card-header">
                    <strong>Department Preview</strong>
                </div>

                <div class="card-body">

                    <div class="card border-primary">

                        <div class="card-body">

                            <div class="d-flex
                                justify-content-between
                                align-items-start
                                mb-3">

                                <div>

                                    <h4 id="departmentNamePreview"
                                        class="card-title mb-1">

                                        New Department
                                    </h4>

                                    <span class="text-muted">

                                        Start Date:

                                        <span id="departmentDatePreview">
                                            Not selected
                                        </span>

                                    </span>

                                </div>

                                <span class="badge bg-primary">
                                    New
                                </span>

                            </div>

                            <hr />

                            <div class="row text-center">

                                <div class="col-6">

                                    <small class="text-muted d-block">
                                        Courses
                                    </small>

                                    <strong>
                                        0
                                    </strong>

                                </div>

                                <div class="col-6">

                                    <small class="text-muted d-block">
                                        Instructors
                                    </small>

                                    <strong>
                                        0
                                    </strong>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="d-flex gap-2 mb-4">

                <button type="submit"
                        class="btn btn-primary">

                    Create Department
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function() {

                const nameInput =
                    document.getElementById("Name");

                const dateInput =
                    document.getElementById("StartDate");

                const namePreview =
                    document.getElementById(
                        "departmentNamePreview"
                    );

                const datePreview =
                    document.getElementById(
                        "departmentDatePreview"
                    );

                function updatePreview() {
                    namePreview.textContent =
                        nameInput.value.trim()
                        || "New Department";

                    datePreview.textContent =
                        dateInput.value
                        || "Not selected";
                }

                nameInput.addEventListener(
                    "input",
                    updatePreview
                );

                dateInput.addEventListener(
                    "input",
                    updatePreview
                );

                updatePreview();
            }
        );
    </script>
}